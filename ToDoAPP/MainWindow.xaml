<Window x:Class="ToDoAPP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ToDoAPP"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.Resources>
        <DataTemplate x:Key="ActiveTaskTemplate">
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0" Checked="TaskCompleted_Checked" Tag="{Binding}" />
                <TextBlock Grid.Column="1" Text="{Binding}" VerticalAlignment="Center" TextWrapping="Wrap" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0">
                    <Button Click="EditTask_Click" Padding="5" ToolTip="Edit Task" Margin="0,0,5,0" Tag="{Binding}">
                        <TextBlock Text="✏️" FontFamily="Segoe UI Emoji" />
                    </Button>
                    <Button Click="DeleteTask_Click" Padding="5" ToolTip="Delete Task" Tag="{Binding}">
                        <TextBlock Text="🗑️" FontFamily="Segoe UI Emoji" />
                    </Button>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="CompletedTaskTemplate">
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0" IsChecked="True" Unchecked="TaskCompleted_Unchecked" Tag="{Binding}" />
                <TextBlock Grid.Column="1" Text="{Binding}" VerticalAlignment="Center" TextWrapping="Wrap" TextDecorations="Strikethrough" Foreground="Gray" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0">
                    <Button Click="DeleteTask_Click" Padding="5" ToolTip="Delete Task" Tag="{Binding}">
                        <TextBlock Text="🗑️" FontFamily="Segoe UI Emoji" />
                    </Button>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox x:Name="TaskInput" Width="300" Margin="0,0,10,0" Padding="5" KeyDown="TaskInput_KeyDown" />
            <Button x:Name="AddButton" Content="Add Task" Width="100" Click="AddTask_Click" />
        </StackPanel>

        <ListBox x:Name="TaskListView" Grid.Row="1" FontSize="16" HorizontalContentAlignment="Stretch" ItemTemplate="{StaticResource ActiveTaskTemplate}" />

        <TextBlock Grid.Row="2" Text="Completed Tasks" FontSize="18" FontWeight="Bold" Margin="0,10,0,10" />

        <ListBox x:Name="CompletedTaskListView" Grid.Row="3" FontSize="16" HorizontalContentAlignment="Stretch" ItemTemplate="{StaticResource CompletedTaskTemplate}" />
    </Grid>
</Window>
